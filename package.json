    "@oruga-ui/theme-bulma": "^0.9.0",
    "@vueform/multiselect": "^2.6.11",
    "bulma": "^1.0.4",
    "echarts": "^6.1.0",
    "firebase": "^12.16.0",
    "moment": "^2.30.1",
    "moving-average": "^1.0.1",
    "register-service-worker": "^1.7.2",
    "vue": "^3.5.40",
    "vue-echarts": "^8.0.1",
    "vue-gtag": "^3.7.1",
    "vue-json-csv": "^2.1.0",
    "vue-router": "^5.2.0",
    "vuefire": "^3.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
